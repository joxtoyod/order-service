# Copy to .env and adjust. NEVER put production credentials here.

APP_ENV=local
LOG_LEVEL=INFO

# Database (local container)
DB_NAME=orders
DB_USER=orders
DB_PASSWORD=orders

# Uncomment to let the VS Code debugger attach on port 5005
# JAVA_TOOL_OPTIONS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
